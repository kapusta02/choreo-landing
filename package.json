{
  "name": "choreo-front",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "compress-images": "imagemin public/images/* --out-dir=public/images --plugin=pngquant --plugin=mozjpeg",
    "convert-webp": "imagemin public/images/* --out-dir=public/images --plugin=webp",
    "convert-webp-slider": "imagemin public/images/slider/* --out-dir=public/images/slider --plugin=webp",

    "optimize-images": "npm run compress-images && npm run convert-webp && npm run convert-webp-slider",
    "deploy": "npm run optimize-images && vite build && gh-pages -d dist"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.7.0",
    "@tanstack/react-query": "^5.85.5",
    "antd": "^5.27.1",
    "antd-mask-input": "^2.0.7",
    "axios": "^1.11.0",
    "js-cookie": "^3.0.5",
    "react": "^19.1.0",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.1.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^6.23.0",
    "swiper": "^11.2.10",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/js-cookie": "^3.0.6",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.26.1",
    "vite": "^6.3.1"
  }
}
